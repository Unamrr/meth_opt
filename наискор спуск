#include <iostream>
#include <cmath>
using namespace std;

// Наша функция
double f(double x1, double x2) {
    return x1*x1 + 5*x2*x2 + x1*x2 + x1;
}

// Вспомогательная функция phi(t)
double phi(double t, double x1, double x2, double g1, double g2) {
    return f(x1 - t*g1, x2 - t*g2);
}

// 1. МЕТОД СВЕННА
void swenn(double x1, double x2, double g1, double g2, double& a, double& b) {
    double h = 0.1;
    double t0 = 0;
    double t1 = h;

    if (phi(t1, x1, x2, g1, g2) < phi(t0, x1, x2, g1, g2)) {
        double t2 = t1 + h;
        while (phi(t2, x1, x2, g1, g2) < phi(t1, x1, x2, g1, g2)) {
            t0 = t1;
            t1 = t2;
            t2 = t2 + h;
        }
        a = t0; b = t2;
    } else {
        double t2 = t1 - h;
        while (phi(t2, x1, x2, g1, g2) < phi(t1, x1, x2, g1, g2)) {
            t0 = t1;
            t1 = t2;
            t2 = t2 - h;
        }
        a = t2; b = t0;
    }
}

// 2. МЕТОД ЗОЛОТОГО СЕЧЕНИЯ
double golden(double a, double b, double x1, double x2, double g1, double g2, double eps_t) {
    double phi_g = (1 + sqrt(5)) / 2; 
    double y = b - (b - a) / phi_g;
    double z = a + (b - a) / phi_g;
    
    while (abs(b - a) > eps_t) {
        if (phi(y, x1, x2, g1, g2) < phi(z, x1, x2, g1, g2)) {
            b = z;
            z = y;
            y = b - (b - a) / phi_g;
        } else {
            a = y;
            y = z;
            z = a + (b - a) / phi_g;
        }
    }
    return (a + b) / 2;
}

int main() {
    setlocale(LC_ALL, "Russian");

    double x1 = 1.0, x2 = 1.0;
    double eps1 = 0.1, eps2 = 0.15;
    int M = 10;
    double eps_t = 0.000001;
    
    int iter_count = 0; // <--- СЧЕТЧИК ИТЕРАЦИЙ

    cout << "k\t x1\t\t x2\t\t t\t\t f(x)\n";

    for (int k = 0; k <= M; k++) {
        double g1 = 2*x1 + x2 + 1;
        double g2 = x1 + 10*x2;

        double norm_g = sqrt(g1*g1 + g2*g2);
        if (norm_g < eps1) {
            cout << "Остановка по градиенту!\n";
            break;
        }

        if (k == M) {
            cout << "Достигнут лимит итераций!\n";
            break;
        }

        double a, b;
        swenn(x1, x2, g1, g2, a, b); 
        double t = golden(a, b, x1, x2, g1, g2, eps_t); 

        double x1_new = x1 - t*g1;
        double x2_new = x2 - t*g2;

        double dist = sqrt((x1_new - x1)*(x1_new - x1) + (x2_new - x2)*(x2_new - x2));
        double diff_f = abs(f(x1_new, x2_new) - f(x1, x2));

        cout << k << "\t " << x1_new << "\t " << x2_new << "\t " << t << "\t " << f(x1_new, x2_new) << "\n";
        
        iter_count++; // <--- УВЕЛИЧИВАЕМ СЧЕТЧИК НА КАЖДОЙ ИТЕРАЦИИ

        if (dist < eps2 && diff_f < eps2) {
            cout << "\nОба условия выполнены! Остановка.\n";
            cout << "Точка минимума: x* = (" << x1_new << "; " << x2_new << ")\n";
            cout << "f(x*) = " << f(x1_new, x2_new) << "\n";
            break;
        }

        x1 = x1_new;
        x2 = x2_new;
    }
    
    cout << "Количество итераций = " << iter_count << endl; // <--- ВЫВОДИМ СЧЕТЧИК

    return 0;
}
